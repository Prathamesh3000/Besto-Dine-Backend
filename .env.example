# BestoDine — backend environment template.
#
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# This file documents the variables the code reads; it holds no secrets.
# Every value below is a placeholder or a documented default.

# ─── Core ────────────────────────────────────────────────────────────
PORT=5000
MONGO_URL=mongodb://localhost:27017/bestodine
# Long random string (e.g. `openssl rand -hex 48`). Signs every JWT.
JWT_SECRET=change-me-to-a-long-random-string
# Keep "development" for LOCAL DEV ONLY. Any live deployment MUST set
# NODE_ENV=production (stricter CORS, secure cookies, generic 5xx errors,
# production env checks).
NODE_ENV=development
# Winston log level (error | warn | info | debug).
LOG_LEVEL=info

# ─── Network / proxy ─────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173
# Also allow localhost / private-LAN origins (phones on the same Wi-Fi).
# Default: on in development, off in production.
CORS_ALLOW_LAN=
# Number of reverse-proxy hops in front of Node (1 = nginx / PaaS router),
# `false` when Node is exposed directly, or a list of trusted proxy
# addresses. Rate limits key on the client IP, so set this correctly.
TRUST_PROXY=1

# ─── Sessions / tokens ───────────────────────────────────────────────
# Access-token lifetime (jsonwebtoken `expiresIn` string: 15m, 1h, …).
ACCESS_TOKEN_TTL=30m
SUPERADMIN_ACCESS_TOKEN_TTL=15m
# Refresh-session lifetime in hours, per audience (sliding — every
# refresh restarts it). Staff / super admin only; customers use the
# inactivity timeout below.
REFRESH_TTL_HOURS_STAFF=168
REFRESH_TTL_HOURS_SUPERADMIN=12
# CUSTOMERS (QA N14):
#   CUSTOMER_IDLE_TIMEOUT_MINUTES — inactivity timeout. Each use of the
#     session (token refresh while the customer is interacting) extends
#     it by this many minutes; after this long with no use the customer
#     sees "Your session expired, please log in again". Default 60.
#   SESSION_MAX_HOURS_CUSTOMER (below) — a customer login ends this many
#     hours after sign-in, however active. Default 1.
# Guest QR-scan diners have no login (SCAN_TOKEN_TTL); their guest session
# ends once their final bill is paid.
CUSTOMER_IDLE_TIMEOUT_MINUTES=60
# Table QR scan-session token lifetime.
SCAN_TOKEN_TTL=4h
# Also deliver the access token in an httpOnly cookie (keep off for now).
USE_COOKIE_AUTH=false

# ─── OTP ─────────────────────────────────────────────────────────────
# HMAC key for stored OTP hashes (falls back to JWT_SECRET when empty).
OTP_SECRET=change-me-otp-secret
# Max OTP sends per mobile per UTC day.
OTP_DAILY_SEND_CAP=10
# SMS provider for OTPs: msg91 | twilio (empty = log to console in dev).
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Monitoring ──────────────────────────────────────────────────────
# Sentry DSN (https://sentry.io → Project Settings → Client Keys).
# Leave empty to disable Sentry.
SENTRY_DSN=

# ─── Payments (Razorpay) ─────────────────────────────────────────────
# Keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Images ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Extra hostnames (comma-separated) the image liveness checker may fetch,
# on top of the built-in Cloudinary / known CDN hosts.
IMAGE_HOST_ALLOWLIST=
# Optional Google Custom Search (menu image suggestions).
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# ─── Google Sign-In ──────────────────────────────────────────────────
# The OAuth 2.0 *Web application* client ID from Google Cloud Console.
#
# This value is PUBLIC by design — the same string ships in the browser
# bundle as VITE_GOOGLE_CLIENT_ID. That is not a leak.
#
# There is deliberately NO GOOGLE_CLIENT_SECRET here. This integration
# uses the ID-token flow: the browser gets a signed identity token and
# the server verifies it against Google's published public keys. We
# never call Google APIs on the user's behalf, so there is no access
# token to obtain and no secret to store. If you ever see a client
# secret being added for plain sign-in, something has been switched to
# the authorization-code flow by mistake.
#
# Leaving this blank cleanly disables Google Sign-In: the button does
# not render and POST /auth/google answers 503.
#
# Accepts a comma-separated list if you later add Android/iOS clients.
GOOGLE_CLIENT_ID=

# ─── Password reset ──────────────────────────────────────────────────
# Base URL of the customer frontend. Reset links are built as
# ${FRONTEND_URL}/reset-password?token=... — if this is wrong, every
# reset email points somewhere useless.
FRONTEND_URL=http://localhost:5173

# ─── Email delivery ──────────────────────────────────────────────────
# Provider for password-reset and tenant lifecycle mail. Unset = SMTP when
# SMTP_HOST/SMTP_USER/SMTP_PASS are set, otherwise dev mode (mail is
# logged to the server console instead of sent).
# One of: smtp | sendgrid | resend | mailgun
EMAIL_PROVIDER=
EMAIL_FROM=BestoDine <no-reply@example.com>
# Fill in only the one matching EMAIL_PROVIDER:
SENDGRID_API_KEY=
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMTP (nodemailer). Also used as the automatic fallback if the API
# provider send fails. Gmail example: smtp.gmail.com / 587 / an app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# Falls back to EMAIL_FROM when empty.
SMTP_FROM=BestoDine <no-reply@example.com>
# true for implicit TLS (port 465); default derived from SMTP_PORT.
SMTP_SECURE=

# ─── Scaling / multiple instances ────────────────────────────────────
# OPTIONAL. Leave empty for a single server (local dev) — everything works
# with zero extra config.
# REQUIRED before running 2+ backend instances behind a load balancer:
# socket.io then uses the Redis adapter so live updates (orders, KDS,
# notifications) reach clients connected to any instance, and cache
# invalidations (settings, list caches) are broadcast to all instances.
# Example: redis://:password@redis-host:6379/0   (use rediss:// for TLS)
# Background jobs do NOT need Redis — they are de-duplicated across
# instances by a MongoDB lease (the `joblocks` collection).
REDIS_URL=
# Hard deadline for graceful shutdown on SIGTERM/SIGINT (ms). Keep below
# your orchestrator's grace period (Kubernetes default: 30s).
SHUTDOWN_TIMEOUT_MS=25000

# ─── Background jobs ─────────────────────────────────────────────────
# Empty values use the defaults in code.
# Each job is cluster-locked (one instance runs each tick); the
# *_DISABLED flags below turn a job off entirely.
# A dine-in guest who scans the QR but doesn't order within this many
# minutes is auto-logged-out and their table freed.
EMPTY_ORDER_GRACE_MINUTES=30
EMPTY_ORDER_SWEEP_MINUTES=15
EMPTY_ORDER_SWEEP_DISABLED=false
STALE_ORDER_STUCK_MINUTES=360
STALE_ORDER_SWEEP_HOURS=1
STALE_ORDER_SWEEP_DISABLED=false
SHIFT_AUTOCLOSE_HOURS=
SHIFT_AUTOCLOSE_SWEEP_HOURS=
SHIFT_AUTOCLOSE_DISABLED=false
BOOKING_REMINDER_SCAN_HOURS=
BOOKING_REMINDER_WINDOW_HOURS=
BOOKING_REMINDER_DISABLED=false
MENU_RESTORE_SCAN_MINUTES=
MENU_RESTORE_DISABLED=false
CATEGORY_IMAGE_HEAL_HOURS=
CATEGORY_IMAGE_HEAL_DISABLED=false
MENU_IMAGE_HEAL_HOURS=
MENU_IMAGE_HEAL_DISABLED=false
DORMANCY_SCAN_HOURS=
DORMANCY_SCAN_DISABLED=false
# IANA timezone for day boundaries in analytics / reports.
APP_TIMEZONE=Asia/Kolkata
ANALYTICS_TIMEZONE=

# ─── Platform / super admin ──────────────────────────────────────────
PUBLIC_BASE_URL=
BACKEND_URL=
MARKETING_DEPLOY_HOOK_URL=
SUPERADMIN_ALERT_EMAILS=
# Used only by the super-admin seed script.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=
# Platform details printed on subscription invoices.
PLATFORM_NAME=BestoDine
PLATFORM_EMAIL=
PLATFORM_PHONE=
PLATFORM_WEBSITE=
PLATFORM_GSTIN=
PLATFORM_ADDRESS_LINE1=
PLATFORM_ADDRESS_LINE2=
PLATFORM_CITY=
PLATFORM_COUNTRY=

# Hotel self-signup (POST /public/register-restaurant): successful
# signups allowed per IP per hour. Rejected attempts don't count.
# SIGNUP_RATE_LIMIT_PER_HOUR=3

# ─── DEV-ONLY payment mock ───────────────────────────────────────────
# true = synthesise Razorpay orders/payments so checkout works without
# valid gateway credentials. No money moves, nothing reaches Razorpay.
# The server REFUSES TO START if this is true while NODE_ENV=production.
RAZORPAY_MOCK=false

# ─── Session lifetime ────────────────────────────────────────────────
# ABSOLUTE ceiling on a login, in hours. Unlike the REFRESH_TTL_* values
# (which are per-token and reset on every rotation) this is set once at
# login and is NOT extended by activity. It is what actually signs a
# user out: without it, a client that keeps refreshing — e.g. a tab left
# open overnight — stays signed in forever.
SESSION_MAX_HOURS_SUPERADMIN=8
SESSION_MAX_HOURS_STAFF=12
# Customers: signed out 1 hour after sign-in (fractions allowed, e.g. 0.5).
SESSION_MAX_HOURS_CUSTOMER=1
