# Backend/.env.docker.example  -- copy to Backend/.env.docker and fill in.
# The repo-root .gitignore ignores `.env.*`, and Backend/.gitignore does NOT
# ignore .env.docker: if you commit from inside Backend/, add `.env.docker`
# to Backend/.gitignore first. Never commit the filled-in copy.
#
# PLACEHOLDERS ONLY. Never put production / Atlas credentials here.
#
# docker-compose.yml FORCES these regardless of this file, so the stack can
# never be pointed at Atlas by accident: MONGO_URL, REDIS_URL, NODE_ENV,
# APP_ENV, PORT.

# Required by server.js (>= 32 chars is also enforced in production).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Browser origins allowed by CORS and the frontend's address (local Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Payments: leave mock ON for local/staging so no real Razorpay keys are needed.
# (The server refuses RAZORPAY_MOCK=true when NODE_ENV=production.)
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# Optional integrations (leave blank to disable):
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
