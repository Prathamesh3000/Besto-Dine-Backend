{
  "//": "Type-check (checkJs) a SMALL allow-list of plain-JS files. TypeScript is not a Backend dependency; npm run typecheck uses the copy installed in ../packages/types. Grow the include list file by file.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "utils/billing.js",
    "utils/billNumber.js",
    "services/orderBillMath.js",
    "vendor/bestodine-types/cjs/index.d.ts"
  ]
}
