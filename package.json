{
  "name": "cafe-management-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:staging": "node scripts/staging-db.js",
    "dev:staging": "node scripts/with-env.js .env.staging nodemon server.js",
    "start:staging": "node scripts/with-env.js .env.staging node server.js",
    "seed:staging": "node scripts/with-env.js .env.staging node Seed/seedStaging.js",
    "health:staging": "node scripts/with-env.js .env.staging node scripts/staging-health.js",
    "pretest": "node scripts/audit-tenant-scope.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:wallet-reports": "node scripts/testWalletReports.js",
    "heal:category-images": "node Seed/healCategoryImages.js",
    "heal:menu-images": "node Seed/healMenuImages.js",
    "audit:tenant": "node scripts/audit-tenant-scope.js",
    "test:isolation": "node scripts/test-tenant-isolation.js",
    "check:tenancy": "node scripts/audit-tenant-scope.js && node scripts/test-tenant-isolation.js",
    "lint": "eslint .",
    "docs:openapi": "node scripts/generate-openapi.js",
    "typecheck": "node ../packages/types/node_modules/typescript/bin/tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@sentry/node": "^10.47.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mongoose": "^9.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.6",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/integration/"
    ]
  }
}
